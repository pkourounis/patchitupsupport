# ── PatchitUP dashboard backend config ──────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env or tenants.json.

# ServiceTitan integration environment: "production" or "integration"
ST_ENV=production

# The app-level App Key from your ServiceTitan Developer Portal integration app.
# (This is per-integration, NOT per-tenant — the same key is used for every tenant.)
ST_APP_KEY=

# Optional explicit endpoint overrides (defaults are derived from ST_ENV).
# ST_AUTH_URL=https://auth.servicetitan.io/connect/token
# ST_API_BASE=https://api.servicetitan.io

# Where per-tenant credentials + metadata live (see tenants.example.json).
TENANTS_FILE=./tenants.json

# HTTP server
PORT=8787
# Comma-separated allowed origins for the dashboard page (CORS). * for any.
CORS_ORIGIN=*

# Sync behavior
# How many days of history to backfill on first sync (covers the 6-month bars + trends).
BACKFILL_DAYS=400
# On each hourly run, re-pull this many recent days and merge (keeps today fresh).
REFRESH_DAYS=45
# Run an hourly cron inside the server process (true) or rely on an external scheduler (false).
CRON_ENABLED=true
